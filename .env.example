[TEMPLATE]
# ============================================================
# BHAR INOX — Variables d'environnement (exemple, sans secrets)
# Copier vers .env.local puis remplacer les valeurs.
# Le site a besoin de l'API PHP + MySQL (XAMPP local ou hébergement PHP).
# ============================================================

# --- API PHP + MySQL (serveur Next.js uniquement) ---
# URL de base de l'API PHP (docroot = server/public)
PHP_API_URL=http://127.0.0.1/bhar-api
# Clé partagée avec server/config.local.php — générée par php server/install.php
PHP_API_KEY=
# La configuration base de données se trouve dans server/config.local.php
# (BHAR_DB_HOST, BHAR_DB_PORT, BHAR_DB_NAME, BHAR_DB_USER, BHAR_DB_PASS).

# --- Administration ---
# Secret de signature des sessions admin (générer : openssl rand -base64 32)
AUTH_SECRET=
# Identifiants administrateur (à changer impérativement en production)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- Site ---
# URL publique utilisée pour le sitemap / robots / Open Graph
NEXT_PUBLIC_SITE_URL=

# --- Emails transactionnels (accusé de réception & notifications) ---
# Service recommandé : Resend (https://resend.com) ou SMTP équivalent
RESEND_API_KEY=
NOTIFY_EMAIL=
