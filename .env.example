[TEMPLATE]
# ============================================================
# BHAR INOX — Variables d'environnement (exemple, sans secrets)
# Copier vers .env.local puis remplacer les valeurs.
# Sans ces variables, le site tourne en MODE DÉMONSTRATION.
# ============================================================

# --- Firebase (production, serveur uniquement) ---
# Console Firebase → Paramètres du projet → Comptes de service
# → Générer une nouvelle clé privée (JSON)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@<projet>.iam.gserviceaccount.com
# Clé privée : coller telle quelle (les \n littéraux sont convertis)
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# --- Administration ---
# Secret de signature des sessions admin (générer : openssl rand -base64 32)
AUTH_SECRET=
# Identifiants administrateur (à changer impérativement en production)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- Site ---
# URL publique utilisée pour le sitemap / robots / Open Graph
NEXT_PUBLIC_SITE_URL=

# --- Emails transactionnels (accusé de réception & notifications) ---
# Service recommandé : Resend (https://resend.com) ou SMTP équivalent
RESEND_API_KEY=
NOTIFY_EMAIL=
