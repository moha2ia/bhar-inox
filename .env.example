[TEMPLATE]
# ============================================================
# BHAR INOX — Variables d'environnement (exemple, sans secrets)
# Copier vers .env.local puis remplacer les valeurs.
# Le site utilise PostgreSQL (local ou Neon) et Vercel Blob.
# ============================================================

# --- Base de données PostgreSQL (serveur Next.js uniquement) ---
# Local : postgresql://postgres:postgres@127.0.0.1:5432/bhar_inox
# Vercel : URL Neon « pooled » (Connection string → Pooled connection)
DATABASE_URL=

# --- Images téléversées (admin) ---
# Jeton du store Vercel Blob (Vercel → Storage → Blob → .env.local)
# Absent en local : les images sont écrites dans public/uploads.
BLOB_READ_WRITE_TOKEN=

# --- Administration ---
# Secret de signature des sessions admin (générer : openssl rand -base64 32)
AUTH_SECRET=
# Identifiants administrateur (à changer impérativement en production)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- Site ---
# URL publique utilisée pour le sitemap / robots / Open Graph
NEXT_PUBLIC_SITE_URL=

# --- Emails transactionnels (accusé de réception & notifications) ---
# Service recommandé : Resend (https://resend.com) ou SMTP équivalent
RESEND_API_KEY=
NOTIFY_EMAIL=
